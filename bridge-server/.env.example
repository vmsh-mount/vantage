# PaytmMoney Trading API — developer.paytmmoney.com
# Required: the app fails to start if either is missing. Real values already exist for
# this project; these placeholders are only for a checked-in example file.
PAYTMMONEY_API_KEY=your_paytmmoney_api_key
PAYTMMONEY_API_SECRET=your_paytmmoney_api_secret

# Filled in by scripts/paytmmoney_login.py (task 4) — leave blank until then.
PAYTMMONEY_ACCESS_TOKEN=

# live | mock. PaytmMoney ships live from day one (credentials already exist).
PAYTMMONEY_MODE=live

# Filled in once INDmoney KYC + token generation is done (see planning.md). Leave
# blank while INDMONEY_MODE=mock.
INDMONEY_ACCESS_TOKEN=

# live | mock. INDmoney stays mocked until real credentials exist.
INDMONEY_MODE=mock

# Used by scripts/indmoney_login.py to regenerate INDMONEY_ACCESS_TOKEN
# automatically (it expires every 24h). Both come from indstocks.com/app/
# api-trading/access-tokens -> Setup TOTP. INDMONEY_CLIENT_ID is the static
# x-api-key shown after setup. INDMONEY_TOTP_SETUP_KEY is the TOTP shared
# secret, shown ONCE at enrollment -- save it then, it can't be recovered
# later without disabling and re-enrolling TOTP. Your account MPIN is never
# stored here or anywhere -- the login script prompts for it interactively
# each run.
INDMONEY_CLIENT_ID=
INDMONEY_TOTP_SETUP_KEY=

# How often the scheduler polls both brokers (task 5).
REFRESH_INTERVAL_MINUTES=20

# Fallback USD->INR rate used only if the live rate API (task 3, fx.py) is
# unreachable. Leave blank to disable the fallback (fx.py will error instead of
# silently using a stale rate).
FX_MANUAL_RATE=

# Path to the local SQLite file, relative to backend/.
DATABASE_PATH=vantage.db

# Origin allowed to call this API in dev — the Vite dev server's default port.
CORS_ORIGIN=http://localhost:5173

# Task 27 — daily digest email (SMTP). Leave SMTP_HOST blank to disable
# sending; the scheduled job still runs and records a clear failure via the
# dead-man's-switch instead of crashing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DIGEST_FROM_EMAIL=
DIGEST_RECIPIENT_EMAIL=
# 24h local time (Asia/Kolkata) the digest job fires.
DIGEST_SEND_HOUR=7
DIGEST_SEND_MINUTE=0

# Task 28a — path to the claude CLI binary. Leave as "claude" to resolve via
# PATH (fine for local dev); override only if bridge-server runs somewhere
# that doesn't inherit an interactive shell's PATH.
CLAUDE_CLI_PATH=claude
