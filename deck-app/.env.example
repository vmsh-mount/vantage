# Base URL of bridge-server. No dev proxy needed — CORS is already configured
# on the backend for Vite's default port (http://localhost:5173).
#
# Use 127.0.0.1, not localhost: on this machine "localhost" resolves to ::1
# first, and something else (e.g. a Docker container) may already be bound to
# that port's IPv6 wildcard, silently stealing requests meant for bridge-server
# (which only binds 127.0.0.1). 127.0.0.1 sidesteps the ambiguity entirely.
VITE_API_BASE_URL=http://127.0.0.1:8000
